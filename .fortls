{
  "source_dirs": [
    "src/**",
    "tests/**",
    "examples/**"
  ],
  "excl_paths": [
    "build-ci/**",
    "ci/**",
    "cmake/**",
    "install/**",
    "submodules/**",
    "tools/**"
  ],
  "include_dirs": [
    "src/numfort/include",
    "src/numfort/**/include",
    "tests/**/include",
    "examples/**/include"
  ],
  "lowercase_intrinsics": true,
  "pp_defs": {
    "PREC": "real64"
  },
  "disable_autoupdate": true
}
